# Copy to android/keystore.properties (gitignored) for local signed release builds.
# CI uses SAHAKAR_KEYSTORE_* environment variables instead. Never commit the
# real file or the keystore. storeFile is relative to android/ or absolute.
storeFile=../../sahakar-upload.jks
storePassword=<keystore password>
keyAlias=<key alias>
keyPassword=<key password>
