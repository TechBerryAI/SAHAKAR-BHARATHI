# Normalise text to LF in the repository. Windows checkouts with
# core.autocrlf=true still get CRLF for ordinary files, but the entries
# below are pinned so they run on Linux CI and WSL.
* text=auto

# Shell scripts must keep LF or bash fails with "$'\r': command not found".
*.sh text eol=lf
android/gradlew text eol=lf
.githooks/* text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
