# =============================================================================
# Sahakar Bharati API — environment template
# Copy this file to .env and set values for your machine.
# Never commit .env, production credentials, or personal data.
# =============================================================================

# --- Application --------------------------------------------------------------
# development | test | production. Any other value is rejected at startup.
# Production requires a remote DATABASE_URL with TLS, https-only CORS origins,
# and disables /docs. It never falls back to these local defaults.
ENVIRONMENT=development
APP_NAME=Sahakar Bharati API
# Local bind hints only. Production listens on 0.0.0.0:$PORT via the process manager.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
# Install PostgreSQL locally. Create two empty databases before first run:
#   createdb -h localhost -U sahakar sahakar
#   createdb -h localhost -U sahakar sahakar_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sahakar
POSTGRES_PASSWORD=
POSTGRES_DB=sahakar
POSTGRES_TEST_DB=sahakar_test

# Optional full URL overrides. Leave blank in development to build the URL from the fields above.
# postgres:// and postgresql:// are accepted and rewritten to postgresql+psycopg://.
# Production requires DATABASE_URL and will not start against localhost.
# Tests use TEST_DATABASE_URL or POSTGRES_TEST_DB only. They never fall back to DATABASE_URL.
DATABASE_URL=
TEST_DATABASE_URL=
# Optional: owner credential used only by `alembic upgrade head`, so the running
# API can use a least-privilege DATABASE_URL (infra/supabase/runtime_role.sql).
# Example shape: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=

# --- Sessions -----------------------------------------------------------------
# Opaque bearer-token lifetime in seconds. Default is 7 days.
SESSION_TTL_SECONDS=604800

# --- Abuse protection ---------------------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=3600
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
MAX_REQUEST_BYTES=65536
# memory: per-process counters, for local development and tests only.
# postgres: shared sliding-window rows in rate_limit_buckets (migrations 0006
# and 0009). Production refuses to start unless this is postgres, including a
# single Render instance. render.yaml sets postgres.
RATE_LIMIT_BACKEND=memory
# Development uses the TCP peer and ignores CF-Connecting-IP, X-Forwarded-For,
# and X-Real-IP. Render sets cf-connecting-ip. See docs/DEPLOYMENT.md.
CLIENT_IP_SOURCE=peer

# --- HTTP ---------------------------------------------------------------------
# Comma-separated browser origins. Mobile clients do not use CORS. Never use *.
# Local Vite (default below). Production Render is set in render.yaml to:
# https://sahakarbharati-e3b04.web.app,https://sahakarbharati-e3b04.firebaseapp.com
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- Textbee SMS OTP ----------------------------------------------------------
# Textbee is the current SMS adapter. Registration and OTP logic depend on the
# SmsGateway port, not on these HTTP details. Production refuses to start without
# TEXTBEE_API_KEY, and TEXTBEE_BASE_URL must be https. Leave the device id blank
# to use the account's default phone. Do not put real keys in this file.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# How long the 6-digit code can be confirmed. Default 5 minutes.
OTP_TTL_SECONDS=300
# How long the registration token from a successful confirm stays valid. Default 15 minutes.
OTP_VERIFICATION_TTL_SECONDS=900
# Minimum gap between OTP sends for the same mobile. Default 60 seconds.
OTP_RESEND_SECONDS=60
# Wrong guesses allowed for one code before that challenge is locked. Default 5.
OTP_MAX_ATTEMPTS=5
# Sends allowed per mobile in OTP_SEND_RATE_WINDOW_SECONDS. Default 5 per hour.
OTP_SEND_RATE_LIMIT=5
# Sends allowed per client IP in the same window. Default 30 per hour so a
# village network is not blocked after a handful of registrations. The per-mobile
# cap above is the strict limit.
OTP_SEND_IP_RATE_LIMIT=30
OTP_SEND_RATE_WINDOW_SECONDS=3600
# Confirm attempts allowed per client IP. Default 30 per 15 minutes. Brute force
# of one code is still stopped by OTP_MAX_ATTEMPTS.
OTP_CONFIRM_RATE_LIMIT=30
OTP_CONFIRM_RATE_WINDOW_SECONDS=900
