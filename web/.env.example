# FastAPI base URL. Required. No trailing slash needed.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production builds set this in CI to https://sahakar-bharathi-api.onrender.com

# Legacy Firebase web config. Unused by the FastAPI client; kept for local
# reference if Auth/Firestore files are re-enabled. Do not put secrets here.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_USE_EMULATORS=
